{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build ASM",
            "type": "shell",
            "command": "nasm",
            "args": [
                "-f",
                "win64",
                "main.asm",
                "-o",
                "main.obj"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Link ASM",
            "type": "shell",
            "command": "gcc",
            "args": [
                "-m64",
                "main.obj",
                "-o",
                "main.exe"
            ],
            "dependsOn": "Build ASM",
            "group": "build",
            "problemMatcher": []
        }
    ]
}